# ============================================================
# RAG 金融研报智能问数系统 - 环境变量示例
# 用法：复制为 .env 并填写必填项（cp .env.example .env）
# 所有项均可被环境变量同名覆盖；未配置时使用 config/rag_config.py 默认值
# ============================================================

# ===== 必填：阿里云百炼 DashScope =====
# 控制台 https://dashscope.console.aliyun.com/ → API-KEY 管理
DASHSCOPE_API_KEY=sk-xxxxxxxx

# ===== 模型（可选，有默认值）=====
LLM_MODEL=qwen3.5-plus
EMBEDDING_MODEL=text-embedding-v2
RERANK_MODEL=qwen3-rerank
EMBEDDING_BATCH_SIZE=10
VECTOR_DIMENSION=1536
MAX_TOKENS=2048
TEMPERATURE=0.7

# （Dify 已于 2026-08-30 迁移下线，财务查询走原生 SQL 链路，无需 Dify Key）

# ===== Qdrant 向量库 =====
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=research_reports_v3_full
DISTANCE_METRIC=COSINE
QDRANT_PERSIST_PATH=./qdrant_db

# ===== 检索与精排 =====
RETRIEVAL_K=50
RERANK_TOP_N=10
RERANK_OVERSAMPLE=2
RERANK_MAX_PER_FILE=2
CHUNK_SIZE=1024
CHUNK_OVERLAP=100

# ===== 记忆持久化（#6）=====
# backend：sqlite（默认，零依赖）/ redis（需 Redis 服务）/ none（纯内存）
MEMORY_BACKEND=sqlite
MEMORY_DB_PATH=database/chat_memory.db
MEMORY_REDIS_URL=redis://localhost:6379/0
MEMORY_TTL_SECONDS=86400
CONVERSATION_TIMEOUT_SECONDS=300
ENABLE_MULTI_TURN=false

# ===== 混合检索（#8，默认开）=====
HYBRID_ENABLED=true
HYBRID_RRF_K=60
HYBRID_TOPK_VECTOR=200
HYBRID_TOPK_BM25=200
HYBRID_VECTOR_FLOOR_RATIO=0.95   # 融合结果中向量路保底比例（0=纯RRF；实测 0.95 消除文件级回撤且数字级 +1.8pp）
BM25_INDEX_PATH=database/bm25_index.pkl

# ===== 引用核验（L1）=====
CITATION_CORPUS_ROOT=B题数据及提交说明/全部数据/正式数据/附件5：研报数据
CITATION_MATCH_MODE=comma
CITATION_CHECK_ON_QUERY=true
CITATION_FILTER_MISSING=true
CITATION_FILTER_ZERO_HIT=false

# ===== Agent 编排与 SQL 守卫（#9，2026-08-24）=====
# Agent 规划器后端：handwritten（自研，默认）/ langgraph（实验，StateGraph 对照）
AGENT_PLANNER_BACKEND=handwritten
# LangGraph 多 Agent 单任务直出（supervisor 只拆 1 个任务时跳过汇总 LLM，省 1 次调用，默认 true）
AGENT_MULTI_DIRECT_RESULT=true
# 多 Agent 汇总节点专用模型（留空=跟随 LLM_MODEL；qwen-flash 压汇总耗时约 60%）
AGGREGATOR_MODEL=qwen-flash
# Agent 循环是否开启思考模式（qwen3.5-plus 推理模型：默认关闭避免耗尽 max_tokens）
AGENT_ENABLE_THINKING=false
# SQL 校验：静态校验 + MySQL 编译（AGENT_SQL_VALIDATE 默认开，AGENT_NATIVE_RETRY 次）
AGENT_SQL_VALIDATE=true
LLM_TIMEOUT=300
# MySQL（SQL 守卫编译终审用，schema 见 database/schema.sql）
# 注意：生产/公网部署务必修改以下两个默认密码（本地开发可保持）
MYSQL_ROOT_PASSWORD=123456
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=financial_database

# ===== 路径（构建索引用，默认指向 测试数据/ 目录）=====
# MARKDOWN_DIR=测试数据/附件5：研报数据/个股研报-解析结果-完整版-2.0
# EXCEL_METADATA_PATH=测试数据/附件5：研报数据/医疗服务_个股_研报信息.xlsx
# INDUSTRY_MARKDOWN_DIR=测试数据/附件5：研报数据/行业研报-解析结果-完整版-2.0
# INDUSTRY_EXCEL_PATH=测试数据/附件5：研报数据/医疗服务_行业_研报信息.xlsx
# NEW_STOCK_DIR=测试数据/附件5：研报数据/个股研报-解析结果-完整版-2.0
# NEW_INDUSTRY_DIR=测试数据/附件5：研报数据/行业研报-解析结果-完整版-2.0

# ===== 重试与超时 =====
# MAX_RETRIES=5
# REQUEST_TIMEOUT=30
# STREAM=false

# ===== 耗时优化 =====
# 多 Agent 汇总/规划节点专用模型（qwen-flash 更快；留空跟随 LLM_MODEL）
# AGGREGATOR_MODEL=qwen-flash
# SUPERVISOR_MODEL=qwen-flash
# 生成阶段上下文条数（默认 5；引用仍按 RERANK_TOP_N 全量构建）
# GENERATOR_CONTEXT_TOP_N=10
